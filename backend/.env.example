# ── Copy this file to .env and fill in your values ───────────────────────
# DO NOT commit .env — only .env.example goes to GitHub

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ── Supabase ──────────────────────────────────────────────────────────────
# Get these from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Agent JWT ─────────────────────────────────────────────────────────────
# Use any strong random string (min 32 characters)
AGENT_JWT_SECRET=replace-this-with-a-strong-random-secret-min-32-chars
AGENT_JWT_EXPIRES_IN=24h

# ── AI APIs (optional — chatbot uses rule engine if not set) ──────────────
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── Python path (optional — defaults to "python") ────────────────────────
# Change to "python3" if needed on your system
PYTHON_PATH=python
